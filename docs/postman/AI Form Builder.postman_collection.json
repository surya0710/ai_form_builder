{
  "info": {
    "name": "AI Form Builder",
    "description": "REST API for AI Form Builder — forms, fields, AI generation, import, public forms, and submissions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "formUuid", "value": "" },
    { "key": "fieldUuid", "value": "" },
    { "key": "submissionUuid", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Notes — Create Sanctum Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Create a token in tinker:\n\n$user = App\\Models\\User::where('email','demo@example.com')->first();\necho $user->createToken('postman')->plainTextToken;\n\nPaste the token into the collection variable `token`."
          }
        }
      ]
    },
    {
      "name": "Forms",
      "item": [
        {
          "name": "List Forms",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/forms?per_page=15"
          }
        },
        {
          "name": "Create Form",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Employee Feedback\",\n  \"description\": \"Share your feedback\"\n}"
            },
            "url": "{{baseUrl}}/forms"
          }
        },
        {
          "name": "Show Form",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/forms/{{formUuid}}"
          }
        },
        {
          "name": "Update Form",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Form\",\n  \"status\": \"draft\"\n}"
            },
            "url": "{{baseUrl}}/forms/{{formUuid}}"
          }
        },
        {
          "name": "Publish Form",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/forms/{{formUuid}}/publish"
          }
        },
        {
          "name": "Archive Form",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/forms/{{formUuid}}/archive"
          }
        },
        {
          "name": "Delete Form",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/forms/{{formUuid}}"
          }
        }
      ]
    },
    {
      "name": "AI Generation",
      "item": [
        {
          "name": "Generate Form",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Create a customer satisfaction survey with email, rating, and comments\"\n}"
            },
            "url": "{{baseUrl}}/forms/generate"
          }
        }
      ]
    },
    {
      "name": "Import",
      "item": [
        {
          "name": "Import Form",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Upload docs/sample-files/*.docx or *.xlsx"
                }
              ]
            },
            "url": "{{baseUrl}}/forms/import"
          }
        }
      ]
    },
    {
      "name": "Fields",
      "item": [
        {
          "name": "Add Field",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Email\",\n  \"type\": \"email\",\n  \"is_required\": true,\n  \"validation_rules\": [\"required\", \"email\"]\n}"
            },
            "url": "{{baseUrl}}/forms/{{formUuid}}/fields"
          }
        },
        {
          "name": "Update Field",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Work Email\",\n  \"type\": \"email\",\n  \"is_required\": true\n}"
            },
            "url": "{{baseUrl}}/fields/{{fieldUuid}}"
          }
        },
        {
          "name": "Duplicate Field",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/fields/{{fieldUuid}}/duplicate"
          }
        },
        {
          "name": "Reorder Fields",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"field_ids\": [1, 2, 3]\n}"
            },
            "url": "{{baseUrl}}/forms/{{formUuid}}/reorder-fields"
          }
        },
        {
          "name": "Delete Field",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/fields/{{fieldUuid}}"
          }
        }
      ]
    },
    {
      "name": "Public Forms",
      "item": [
        {
          "name": "Show Public Form",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/public/forms/{{formUuid}}"
          }
        },
        {
          "name": "Submit Public Form",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Example\",\n  \"email\": \"alex@example.com\",\n  \"department\": \"Engineering\",\n  \"rating\": \"5\",\n  \"comments\": \"Great workplace\"\n}"
            },
            "url": "{{baseUrl}}/public/forms/{{formUuid}}/submit"
          }
        }
      ]
    },
    {
      "name": "Submissions",
      "item": [
        {
          "name": "List Submissions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/forms/{{formUuid}}/submissions"
          }
        },
        {
          "name": "Show Submission",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionUuid}}"
          }
        },
        {
          "name": "Delete Submission",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/submissions/{{submissionUuid}}"
          }
        }
      ]
    }
  ]
}
